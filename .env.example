# Optional. Without a key BrandProof runs in rule-engine mode (fully working, no AI).
# Get a free key at https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=
# Optional model override
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional fallback chain if the main model is retired, rate-limited or overloaded
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash
