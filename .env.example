# All variables are optional. With none set, BrandProof runs in rule-engine mode with the demo sandbox.

# AI layer (https://aistudio.google.com -> Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash

# Team workspaces (https://supabase.com -> Project Settings -> API). Run supabase/schema.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email notifications (optional; in-app notifications work without these). Example: Gmail App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
